    "cases": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"type": "object", "required": ["caseId", "category", "label", "requiredChannel", "expected", "stimulus"], "properties": {"category": {"enum": ["legitimate", "adversarial", "lifecycle_failure"]}, "stimulus": {"type": "object"}}, "additionalProperties": true}}
  },
  "additionalProperties": true
}
