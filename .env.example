# Trusted backend only. Never mount this file into a worker or runtime Codex.
PRESENTER_ACCESS_CODE=replace-with-a-random-presenter-code
PUBLIC_ORIGIN=http://127.0.0.1:8000
VIBESECUR_DATA_DIR=./data
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# Enable only after the pinned checkpoint is warmed and suitability measured.
VIBESECUR_LAYA_ENABLED=0
# Deployment wiring and isolated executor images are configured by deploy scripts.
# Comma-separated reverse-proxy peer addresses whose X-Forwarded-For is trusted for login rate limiting.
VIBESECUR_TRUSTED_PROXIES=
