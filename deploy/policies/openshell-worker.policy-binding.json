{
  "sourceTemplateSha256": "8dbc5d40c5a66388721353319595a70b2ef909f9a9a55de5b7344a0851e7f1ac",
  "policy": {
    "version": 1,
    "filesystem_policy": {
      "include_workdir": true,
      "read_only": [
        "/usr",
        "/lib",
        "/lib64",
        "/proc",
        "/dev/urandom",
        "/opt",
        "/app",
        "/etc",
        "/var/log"
      ],
      "read_write": [
        "/tmp",
        "/workspace",
        "/dev/null",
        "/dev/pts"
      ]
    },
    "landlock": {
      "compatibility": "best_effort"
    },
    "network_policies": {
      "invoice_application": {
        "name": "invoice-application",
        "endpoints": [
          {
            "host": "__PAYMENT_HOST__",
            "port": 8000,
            "protocol": "rest",
            "enforcement": "enforce",
            "rules": [
              {
                "allow": {
                  "method": "GET",
                  "path": "/portal"
                }
              },
              {
                "allow": {
                  "method": "GET",
                  "path": "/documents/invoice"
                }
              },
              {
                "allow": {
                  "method": "GET",
                  "path": "/api/context"
                }
              },
              {
                "allow": {
                  "method": "POST",
                  "path": "/api/payments"
                }
              }
            ]
          }
        ],
        "binaries": [
          {
            "path": "/usr/bin/curl"
          },
          {
            "path": "/usr/local/bin/python"
          },
          {
            "path": "/usr/bin/chromium"
          }
        ]
      },
      "model_broker": {
        "name": "model-broker",
        "endpoints": [
          {
            "host": "host.openshell.internal",
            "port": 8000,
            "protocol": "rest",
            "enforcement": "enforce",
            "rules": [
              {
                "allow": {
                  "method": "POST",
                  "path": "/model/v1/chat/completions"
                }
              },
              {
                "allow": {
                  "method": "POST",
                  "path": "/model/v1/responses"
                }
              }
            ]
          }
        ],
        "binaries": [
          {
            "path": "/usr/bin/curl"
          },
          {
            "path": "/usr/local/bin/python"
          }
        ]
      }
    }
  }
}
