version: 1
filesystem_policy:
  include_workdir: true
  read_only: [/usr, /lib, /lib64, /proc, /dev/urandom, /opt, /app, /etc, /var/log]
  read_write: [/tmp, /workspace, /dev/null, /dev/pts]
landlock:
  compatibility: best_effort
network_policies:
  invoice_application:
    name: invoice-application
    endpoints:
      - host: __PAYMENT_IP__
        allowed_ips: [__PAYMENT_IP__/32]
        port: 8000
        protocol: rest
        enforcement: enforce
        rules:
          - allow: {method: GET, path: /portal}
          - allow: {method: GET, path: /documents/invoice}
          - allow: {method: GET, path: /api/context}
          - allow: {method: GET, path: /api/inventory}
          - allow: {method: POST, path: /api/purchase-orders}
          - allow: {method: POST, path: /api/payments}
    binaries:
      - {path: /usr/bin/curl}
      - {path: /usr/local/bin/python}
      - {path: /usr/bin/chromium}
  model_broker:
    name: model-broker
    endpoints:
      - host: 172.30.0.1
        allowed_ips: [172.30.0.1/32]
        port: 8000
        protocol: rest
        enforcement: enforce
        rules:
          - allow: {method: POST, path: /model/v1/chat/completions}
          - allow: {method: POST, path: /model/v1/responses}
    binaries:
      - {path: /usr/bin/curl}
      - {path: /usr/local/bin/python}
