[Unit]
Description=VibeSecur trusted demo API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=demo
Group=demo
WorkingDirectory=/srv/vibesecur/app
EnvironmentFile=/srv/vibesecur/.env.private
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/vibesecur/.venv/bin/uvicorn vibesecur.api:create_app --factory --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/srv/vibesecur/data
CapabilityBoundingSet=
RestrictSUIDSGID=true
LimitNOFILE=4096
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
